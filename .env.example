# ==============================================================================
# MyScreen — variaveis de ambiente
#
# Copie para `.env` e preencha. NUNCA comite o `.env` (esta no .gitignore).
# `deploy.sh` gera um `.env` com segredos aleatorios se o arquivo nao existir.
#
# Nenhum valor aqui pode ter um padrao no codigo: `src/lib/env.ts` lanca no
# boot se alguma faltar. Um segredo com fallback hardcoded e o que transforma
# erro de configuracao em falha silenciosa de seguranca.
# ==============================================================================

# Banco (SQLite).
#
# O caminho PRECISA ser absoluto. Um `file:./database.sqlite` relativo e
# resolvido pelo Prisma em relacao ao diretorio do schema — que no container e
# `/app/prisma/`, e nao o volume `app-data:/app/data`. Resultado: o arquivo
# nasce fora do volume e some a cada `docker compose up --build`, levando
# contas, senhas e salas junto.
DATABASE_URL="file:/app/data/database.sqlite"

# Chave HMAC da sessao. Minimo de 32 caracteres.
# Gere com: openssl rand -hex 32
JWT_SECRET=""

# Credenciais da API do LiveKit. TEM QUE SER IDENTICA ao par em `livekit.yaml`
# (o `deploy.sh` sincroniza os dois a cada execucao). Divergir = todo join
# falha por assinatura invalida.
# Gere com: openssl rand -hex 6 / openssl rand -hex 32
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""

# URL do SFU vista pelo servidor (rede interna do Docker).
LIVEKIT_URL="http://livekit:7880"

# URL do SFU vista pelo navegador. Vale APENAS no `next dev` local.
#
# Em producao o `docker-compose.yml` sobrescreve isto com `wss://${DOMAIN}`,
# justamente porque um `.env` reaproveitado da maquina de desenvolvimento
# traria `ws://localhost:7880` e a sinalizacao nunca abriria. O SDK anexa
# `/rtc/v1`, e o Caddy so encaminha `/rtc*` para o SFU.
NEXT_PUBLIC_LIVEKIT_URL="ws://localhost:7880"

# Hostname usado pelo Caddy, pelo certificado e pelo TURN. PRECISA bater com o
# dominio real, senao o Let's Encrypt falha e o `wss://` nao resolve.
DOMAIN="localhost"

# Contato do Let's Encrypt, para os avisos de expiracao de certificado.
ACME_EMAIL="admin@localhost"
